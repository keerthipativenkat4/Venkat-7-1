public class ThreadLifecycleDemo {
    public static void main(String[] args) {

        // Create a child thread
        Thread taskThread = new Thread(() -> {
            try {
                System.out.println("[Child Thread] Task started...");

                for (int i = 1; i <= 3; i++) {
                    System.out.println(
                        "[Child Thread] Processing step " + i + "..."
                    );
                    Thread.sleep(1000);
                }

                System.out.println("[Child Thread] Task completed.");

            } catch (InterruptedException e) {
                System.out.println("[Child Thread] Thread was interrupted.");
                Thread.currentThread().interrupt();
            }
        });

        // Check thread status before starting
        System.out.println(
            "[Main Thread] Before start - Is thread alive? "
            + taskThread.isAlive()
        );

        // Start the child thread
        taskThread.start();

        // Check thread status after starting
        System.out.println(
            "[Main Thread] After start - Is thread alive? "
            + taskThread.isAlive()
        );

        try {
            // Wait for the child thread to finish
            System.out.println(
                "[Main Thread] Waiting for the child thread to finish..."
            );

            taskThread.join();

        } catch (InterruptedException e) {
            System.out.println("[Main Thread] Main thread interrupted.");
            Thread.currentThread().interrupt();
        }

        // Check thread status after completion
        System.out.println(
            "[Main Thread] After join - Is thread alive? "
            + taskThread.isAlive()
        );

        System.out.println(
            "[Main Thread] Execution finished successfully."
        );
    }
}
